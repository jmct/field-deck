% beamercolorthemejmct.sty -- colours for the jmct theme
\ProvidesPackage{beamercolorthemejmct}[2026/10/22 v1.0 jmct beamer colour theme]

\mode<presentation>

\definecolor{off-white}{RGB}{240,240,240}
\definecolor{light-gray}{RGB}{160,160,160}
\definecolor{dark-gray}{RGB}{60,60,60}
\definecolor{galois-blue}{RGB}{0,122,209}
\definecolor{lucid-blue}{RGB}{41,170,225}
\definecolor{dark-lucid-blue}{RGB}{0,125,179}
\definecolor{galois-yellow}{RGB}{255,219,13}
\definecolor{my-magenta}{RGB}{184,26,91}
%\definecolor{my-magenta}{RGB}{200,51,112}

\setbeamercolor*{background canvas}{bg=off-white}
\setbeamercolor*{normal text}{fg=my-magenta}

\setbeamercolor*{title}{fg=dark-gray}
\setbeamercolor*{subtitle}{fg=my-magenta}

\setbeamercolor{frametitle}{fg=my-magenta}
\setbeamercolor{frametitle bar}{fg=lucid-blue}

\setbeamercolor*{itemize item}{fg=dark-lucid-blue}
\setbeamercolor*{itemize subitem}{fg=dark-lucid-blue}
\setbeamercolor*{enumerate item}{fg=dark-lucid-blue}
\setbeamercolor*{enumerate subitem}{fg=dark-lucid-blue}

% Used by \blueit and \code (see beamerthemejmct.sty)
\setbeamercolor{accent}{fg=dark-lucid-blue}
\setbeamercolor{code}{fg=dark-gray}
\setbeamercolor{code comment}{fg=light-gray}
\setbeamercolor{code string}{fg=my-magenta}

\mode<all>
